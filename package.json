{
    "name": "academic-pdf-viewer",
    "displayName": "Academic PDF Viewer",
    "description": "A VS Code PDF reader for academic papers.",
    "version": "1.2.3",
    "icon": "image/icon.png",
    "publisher": "ovolab-veritas",
    "repository": {
        "type": "git",
        "url": "https://github.com/VeriTas-arch/academic-pdf-viewer"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.133.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "pdf",
        "academic",
        "citation",
        "reader",
        "viewer"
    ],
    "galleryBanner": {
        "color": "#111827",
        "theme": "dark"
    },
    "main": "./out/extension.js",
    "enabledApiProposals": [
        "customEditorDiffs"
    ],
    "contributes": {
        "customEditors": [
            {
                "viewType": "academicPdfViewer.pdf",
                "displayName": "Academic PDF Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.pdf"
                    }
                ],
                "priority": {
                    "textEditor": "default",
                    "diffEditor": "default"
                }
            }
        ],
        "commands": [
            {
                "command": "academicPdfViewer.navigateBack",
                "title": "PDF: Navigate Back"
            },
            {
                "command": "academicPdfViewer.navigateForward",
                "title": "PDF: Navigate Forward"
            },
            {
                "command": "academicPdfViewer.reload",
                "title": "PDF: Reload",
                "icon": "$(refresh)"
            },
            {
                "command": "academicPdfViewer.tex.synctexForward",
                "title": "PDF: SyncTeX Forward Search"
            },
            {
                "command": "academicPdfViewer.tex.synctexInverse",
                "title": "PDF: SyncTeX Inverse Search"
            },
            {
                "command": "academicPdfViewer.toggleLinkPreview",
                "title": "PDF: Toggle Link Preview",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf"
            },
            {
                "command": "academicPdfViewer.toggleDiffHighlights",
                "title": "PDF: Toggle Diff Highlights",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive"
            },
            {
                "command": "academicPdfViewer.enableDiffHighlights",
                "title": "PDF Diff: Show Highlights",
                "icon": "$(diff)",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive"
            },
            {
                "command": "academicPdfViewer.disableDiffHighlights",
                "title": "PDF Diff: Hide Highlights",
                "icon": "$(check)",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive"
            },
            {
                "command": "academicPdfViewer.previousDiffChange",
                "title": "PDF Diff: Previous Change",
                "icon": "$(arrow-up)",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && academicPdfViewer.diffHighlightsEnabled"
            },
            {
                "command": "academicPdfViewer.nextDiffChange",
                "title": "PDF Diff: Next Change",
                "icon": "$(arrow-down)",
                "enablement": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && academicPdfViewer.diffHighlightsEnabled"
            }
        ],
        "configuration": {
            "title": "Academic PDF Viewer",
            "properties": {
                "academicPdfViewer.linkPreview.enabled": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "Show a destination preview when holding Control and hovering over internal PDF links."
                },
                "academicPdfViewer.linkPreview.resolutionScale": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 4,
                    "scope": "window",
                    "markdownDescription": "Controls link-preview image clarity without changing its displayed size. The value is the number of rendered image pixels per CSS pixel; higher values use more memory and rendering time."
                },
                "academicPdfViewer.navigation.defaultAltShortcuts": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "Enable the extension's default Alt+Left and Alt+Right PDF navigation shortcuts. The navigation commands remain available for custom keyboard bindings."
                },
                "academicPdfViewer.navigation.mouseButtons": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "description": "Navigate PDF history with the Mouse Back and Mouse Forward buttons while the pointer is over the PDF."
                },
                "academicPdfViewer.navigation.mouseButtonMapping": {
                    "type": "string",
                    "enum": [
                        "standard",
                        "swapped"
                    ],
                    "enumDescriptions": [
                        "Mouse Back navigates back; Mouse Forward navigates forward.",
                        "Mouse Back navigates forward; Mouse Forward navigates back."
                    ],
                    "default": "standard",
                    "scope": "window",
                    "description": "Choose how the two mouse side buttons map to PDF navigation."
                },
                "academicPdfViewer.navigation.defaultSidebar": {
                    "type": "string",
                    "enum": [
                        "pages",
                        "outline",
                        "attachments",
                        "layers"
                    ],
                    "enumDescriptions": [
                        "Show page thumbnails when the sidebar opens.",
                        "Show the document outline when available.",
                        "Show file attachments when available.",
                        "Show optional-content layers when available."
                    ],
                    "default": "pages",
                    "scope": "window",
                    "description": "Choose the view selected when the PDF sidebar opens. Unavailable views fall back to Pages."
                },
                "academicPdfViewer.tex.synctex": {
                    "type": "string",
                    "enum": [
                        "off",
                        "doubleclick",
                        "rightclick"
                    ],
                    "enumDescriptions": [
                        "Disable inverse SyncTeX from the PDF viewer.",
                        "Send inverse SyncTeX on a double-click.",
                        "Show a context-menu entry for inverse SyncTeX after a right-click."
                    ],
                    "default": "doubleclick",
                    "scope": "window",
                    "description": "Choose how inverse SyncTeX is triggered from the PDF viewer."
                }
            }
        },
        "menus": {
            "webview/context": [
                {
                    "command": "academicPdfViewer.tex.synctexInverse",
                    "when": "webviewId == academicPdfViewer.pdf && config.academicPdfViewer.tex.synctex == rightclick",
                    "group": "navigation@1"
                }
            ],
            "editor/title": [
                {
                    "command": "academicPdfViewer.reload",
                    "when": "activeCustomEditorId == academicPdfViewer.pdf",
                    "group": "navigation@4"
                },
                {
                    "command": "academicPdfViewer.enableDiffHighlights",
                    "when": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && !academicPdfViewer.diffHighlightsEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "academicPdfViewer.disableDiffHighlights",
                    "when": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && academicPdfViewer.diffHighlightsEnabled",
                    "group": "navigation@1"
                },
                {
                    "command": "academicPdfViewer.previousDiffChange",
                    "when": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && academicPdfViewer.diffHighlightsEnabled",
                    "group": "navigation@2"
                },
                {
                    "command": "academicPdfViewer.nextDiffChange",
                    "when": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive && academicPdfViewer.diffHighlightsEnabled",
                    "group": "navigation@3"
                }
            ]
        },
        "keybindings": [
            {
                "command": "academicPdfViewer.navigateBack",
                "key": "alt+left",
                "when": "activeCustomEditorId == academicPdfViewer.pdf && config.academicPdfViewer.navigation.defaultAltShortcuts"
            },
            {
                "command": "academicPdfViewer.navigateForward",
                "key": "alt+right",
                "when": "activeCustomEditorId == academicPdfViewer.pdf && config.academicPdfViewer.navigation.defaultAltShortcuts"
            },
            {
                "command": "academicPdfViewer.toggleDiffHighlights",
                "key": "ctrl+alt+d",
                "mac": "cmd+alt+d",
                "when": "activeCustomEditorId == academicPdfViewer.pdf && academicPdfViewer.diffActive"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run clean && npm run compile",
        "check": "npm run build && npm run typecheck:scripts && npm run lint",
        "clean": "node ./scripts/clean.mjs",
        "compile": "npm run compile:extension && npm run compile:webview",
        "compile:extension": "tsc -p ./",
        "compile:webview": "tsc -p ./tsconfig.webview.json",
        "typecheck:scripts": "tsc -p ./tsconfig.scripts.json",
        "lint": "eslint \"src/**/*.ts\" \"src/**/*.mts\" \"scripts/**/*.mts\"",
        "pdfjs:check": "node ./scripts/pdfjsVendor.mts check",
        "pdfjs:update": "node ./scripts/pdfjsVendor.mts update",
        "pdfjs:verify": "node ./scripts/pdfjsVendor.mts verify",
        "test": "node --test test/protocol.test.cjs test/pdfSizeLimits.test.cjs test/pdfDiffAlgorithm.test.mjs test/pdfDiffScheduler.test.mjs test/citationPreviewLines.test.mjs test/keybindings.test.cjs",
        "test:extension": "node test/extensionHost/run.mjs",
        "test:viewer": "node --test test/viewerSmoke.test.mjs"
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@types/vscode": "1.125.0",
        "@vscode/test-electron": "^3.1.0",
        "eslint": "^10.8.1",
        "playwright-core": "^1.62.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0"
    }
}
